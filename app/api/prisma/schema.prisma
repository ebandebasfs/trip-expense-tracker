// Prisma schema for the Trip Expense Tracker API.
// Money is stored as integer cents. Times are stored in UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  // Salted scrypt hash in the form salt:hash. The plain password is never stored.
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
  trips        Trip[]
}

model Session {
  id        String   @id @default(cuid())
  // SHA-256 hex of the session token. The token itself is never stored.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Trip {
  id        String   @id @default(uuid())
  // Owner, set by the server from the logged-in session. Never taken from the request.
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // No unique constraint: two trips of the same user may share a name.
  name      String
  // UTC, set on insert.
  createdAt DateTime @default(now())

  @@index([userId])
}
